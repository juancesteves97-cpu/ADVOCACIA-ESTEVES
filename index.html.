<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Advocacia Esteves — Florianópolis</title>
<meta name="description" content="Advocacia Esteves. Mais de 10 anos de experiência jurídica. Atuação presencial no Centro de Florianópolis e atendimento online em todo o Brasil.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#12232e;
    --ink-soft:#3a4d58;
    --paper:#f6f3ec;
    --paper-raised:#eee9dd;
    --brass:#9c7a3c;
    --brass-deep:#7c5f2a;
    --teal:#3e6e68;
    --line:#d9d2c1;
    --radius:2px;
    font-family:'Source Sans 3',system-ui,-apple-system,sans-serif;
    color-scheme: light;
  }
  * { box-sizing:border-box; margin:0; padding:0; }
  html{ scroll-padding-top: env(safe-area-inset-top,0px); scroll-behavior:smooth; }
  body{
    background:var(--paper);
    color:var(--ink);
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
    line-height:1.55;
  }
  h1,h2,h3{ font-family:'Fraunces',Georgia,serif; font-weight:500; color:var(--ink); }
  a{ color:inherit; }
  img{ max-width:100%; display:block; }
  .wrap{ max-width:1080px; margin:0 auto; padding:0 28px; }

  /* ---- Header ---- */
  header{
    position:sticky; top:0; top:env(safe-area-inset-top,0px);
    z-index:20; background:rgba(246,243,236,.92); backdrop-filter:blur(6px);
    border-bottom:1px solid var(--line);
  }
  .header-inner{ display:flex; align-items:center; justify-content:space-between; padding:18px 28px; max-width:1080px; margin:0 auto; }
  .brand{ font-family:'Fraunces',serif; font-size:1.25rem; letter-spacing:.01em; }
  .brand span{ color:var(--brass-deep); }
  .header-cta{
    display:inline-flex; align-items:center; gap:8px;
    background:var(--ink); color:var(--paper); text-decoration:none;
    padding:10px 18px; font-size:.92rem; font-weight:600; border-radius:var(--radius);
    white-space:nowrap;
  }
  .header-cta:hover{ background:var(--brass-deep); }

  /* ---- Hero ---- */
  .hero{ padding:88px 0 72px; border-bottom:1px solid var(--line); }
  .hero-grid{ display:grid; grid-template-columns:1.2fr .8fr; gap:56px; align-items:center; }
  .hero-tag{ font-size:.95rem; color:var(--teal); font-weight:600; margin-bottom:18px; }
  .hero h1{ font-size:clamp(2.1rem,4.6vw,3.4rem); line-height:1.08; letter-spacing:-.01em; max-width:20ch; }
  .hero p{ margin-top:22px; font-size:1.12rem; color:var(--ink-soft); max-width:46ch; }
  .hero-actions{ display:flex; gap:14px; margin-top:32px; flex-wrap:wrap; }
  .btn-primary{
    background:var(--brass-deep); color:var(--paper); text-decoration:none;
    padding:14px 26px; font-weight:600; font-size:1rem; border-radius:var(--radius);
    display:inline-flex; align-items:center; gap:10px;
  }
  .btn-primary:hover{ background:var(--ink); }
  .hero-panel{
    background:var(--ink); color:var(--paper); padding:14px;
    border-radius:var(--radius); position:relative; overflow:hidden;
  }
  .hero-panel img{ width:100%; border-radius:1px; filter:grayscale(.08); }
  .hero-panel-caption{ padding:18px 8px 10px; }
  .hero-panel-label{ font-size:.85rem; color:#c9b98a; font-weight:600; margin-bottom:6px; }
  .hero-panel-text{ font-size:.98rem; line-height:1.5; color:#e7e2d4; }

  /* ---- Sections ---- */
  section{ padding:64px 0; }
  .section-head{ display:flex; align-items:baseline; gap:16px; margin-bottom:34px; border-bottom:1px solid var(--line); padding-bottom:16px; }
  .section-head h2{ font-size:1.7rem; }

  .about-grid{ display:grid; grid-template-columns:1fr 1fr; gap:48px; }
  .about-grid p{ color:var(--ink-soft); font-size:1.04rem; margin-bottom:14px; }
  .about-grid p:last-child{ margin-bottom:0; }

  .diff-list{ display:grid; grid-template-columns:repeat(2,1fr); gap:24px 40px; }
  .diff-item{ display:flex; gap:16px; align-items:flex-start; }
  .diff-item .mark{ width:8px; height:8px; border-radius:50%; background:var(--teal); margin-top:9px; flex-shrink:0; }
  .diff-item h3{ font-size:1.05rem; font-weight:600; font-family:'Source Sans 3',sans-serif; margin-bottom:4px; }
  .diff-item p{ color:var(--ink-soft); font-size:.95rem; }

  .team{ background:var(--paper-raised); border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
  .team-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:32px; }
  .team-card{ display:flex; flex-direction:column; }
  .team-photo{ width:100%; aspect-ratio:1/1; border-radius:var(--radius); overflow:hidden; border:1px solid var(--line); }
  .team-photo img{ width:100%; height:100%; object-fit:cover; display:block; }
  .team-info{ padding-top:16px; }
  .team-name{ font-family:'Fraunces',serif; font-size:1.15rem; margin-bottom:2px; }
  .team-role{ font-size:.85rem; color:var(--brass-deep); font-weight:600; margin-bottom:6px; }
  .team-text{ font-size:.92rem; color:var(--ink-soft); }

  .local-section{ background:var(--paper-raised); border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
  .local{ display:grid; grid-template-columns:1fr 1fr; gap:48px; }
  .local-card{ padding:28px; border:1px solid var(--line); border-radius:var(--radius); background:var(--paper); }
  .local-card h3{ font-size:1.1rem; margin-bottom:10px; }
  .local-card p{ color:var(--ink-soft); font-size:.98rem; }
  .local-card .icon{ color:var(--brass-deep); font-size:1.3rem; margin-bottom:10px; display:block; }

  .contact{ background:var(--ink); color:var(--paper); }
  .contact .section-head{ border-bottom-color:#324450; }
  .contact .section-head h2{ color:var(--paper); }
  .contact-grid{ display:grid; grid-template-columns:1.1fr .9fr; gap:48px; align-items:start; }
  .contact p{ color:#c7cfd3; font-size:1.05rem; }
  .contact-methods{ margin-top:26px; display:flex; flex-direction:column; gap:16px; }
  .contact-method{ display:flex; gap:14px; align-items:center; text-decoration:none; color:var(--paper); }
  .contact-method .ico{ width:38px; height:38px; border:1px solid #43555f; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .contact-method .label{ font-size:.82rem; color:#9aa9af; }
  .contact-method .value{ font-size:1.05rem; font-weight:600; }
  a.contact-method:hover .ico{ border-color:var(--brass); }

  .oab-note{ border:1px solid #324450; padding:24px; border-radius:var(--radius); }
  .oab-note .k{ font-family:'Fraunces',serif; font-size:1.3rem; margin-bottom:6px; }
  .oab-note p{ font-size:.92rem; }

  footer{ padding:28px 0; border-top:1px solid var(--line); }
  .footer-inner{ display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; font-size:.85rem; color:var(--ink-soft); }

  .fab{
    position:fixed; bottom:calc(22px + env(safe-area-inset-bottom,0px)); right:22px; z-index:30;
    background:#25D366; width:56px; height:56px; border-radius:50%;
    display:flex; align-items:center; justify-content:center; text-decoration:none;
    box-shadow:0 4px 14px rgba(0,0,0,.25);
  }

  @media (max-width:820px){
    .hero-grid, .about-grid, .local, .contact-grid, .team-grid{ grid-template-columns:1fr; }
    .diff-list{ grid-template-columns:1fr; }
    .hero{ padding:56px 0 48px; }
    .hero-panel{ order:-1; }
  }
  @media (max-width:520px){
    .header-inner{ padding:14px 20px; }
    .wrap{ padding:0 20px; }
  }
  @media (prefers-reduced-motion: reduce){ html{ scroll-behavior:auto; } }
</style>
</head>
<body>

